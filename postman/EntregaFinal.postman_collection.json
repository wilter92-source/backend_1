{
  "info": {
    "name": "Entrega final — Turnos y reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden en una base de desarrollo. Verifica CRUD, filtros, Zod, populate, cantidades, vaciado y eliminación. Elimina su reserva y servicio; conserva el mensaje de prueba."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sid",
      "value": ""
    },
    {
      "key": "bid",
      "value": ""
    },
    {
      "key": "mid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Servicio prueba final\",\n  \"description\": \"Creado desde Postman\",\n  \"duration\": 30,\n  \"price\": 25,\n  \"category\": \"prueba-final\",\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('sid', pm.response.json().payload._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Filtrar servicios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services?category=prueba-final&available=true&sortBy=price&order=asc&page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Servicio encontrado', () => pm.expect(pm.response.json().payload.some(x => x._id === pm.collectionVariables.get('sid'))).to.be.true);",
              "pm.test(\"Metadatos de paginación\", function () { const p = pm.response.json().pagination; pm.expect(p).to.have.keys(\"total\", \"page\", \"limit\", \"totalPages\", \"hasPrevPage\", \"hasNextPage\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Cambiar disponibilidad y observar la vista",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services/{{sid}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"available\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No disponible', () => pm.expect(pm.response.json().payload.available).to.be.false);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear reserva con referencia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientName\": \"Ana Prueba\",\n  \"clientEmail\": \"ana@example.com\",\n  \"date\": \"2026-10-10\",\n  \"time\": \"10:30\",\n  \"status\": \"pending\",\n  \"services\": [\n    {\n      \"service\": \"{{sid}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('bid', pm.response.json().payload._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Consultar reserva con populate",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const service = pm.response.json().payload.services[0].service;",
              "pm.test('Referencia poblada', () => { pm.expect(service._id).to.eql(pm.collectionVariables.get('sid')); pm.expect(service.name).to.eql('Servicio prueba final'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Agregar de nuevo el servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Cantidad incrementada', () => pm.expect(pm.response.json().payload.services[0].quantity).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Filtrar reservas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings?status=pending&date=2026-10-10&sort=time&order=asc&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Crear mensaje",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user\": \"Ana Prueba\",\n  \"message\": \"Prueba completa del sistema\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('mid', pm.response.json().payload._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Consultar mensaje",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/messages/{{mid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Vista servicios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/views/services"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Vista reservas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/views/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Rechazar fecha inexistente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientName\": \"Ana\",\n  \"clientEmail\": \"ana@example.com\",\n  \"date\": \"2026-02-30\",\n  \"time\": \"10:30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Modificar cantidad",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 4}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Cantidad 4', () => pm.expect(pm.response.json().payload.services[0].quantity).to.eql(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Rechazar cantidad cero",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Quitar servicio de la reserva",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Sin asociaciones', () => pm.expect(pm.response.json().payload.services).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Volver a asociar servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Vaciar reserva",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Reserva vacía', () => pm.expect(pm.response.json().payload.services).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Asociar para demostrar referencia eliminada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}/services/{{sid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Eliminar servicio de prueba",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/services/{{sid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 La reserva conserva el registro tras eliminar servicio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Referencia eliminada sin romper reserva', () => pm.expect(pm.response.json().payload.services[0].service).to.be.null);"
            ]
          }
        }
      ]
    },
    {
      "name": "21 Eliminar reserva de prueba",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Confirmar reserva eliminada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
